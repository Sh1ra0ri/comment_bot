```gitignore
# Python
__pycache__/
*.py[cod]
*.so

# Virtual environment
.venv/
venv/
env/

# Environment variables
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Type checking
.mypy_cache/

# Build
build/
dist/
*.egg-info/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Database
*.sqlite3
*.db

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Uploads / media
uploads/
media/
```
